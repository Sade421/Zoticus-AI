        "def is_multilabel(row):\n",
        "    kw = str(row[\"keywords\"]).lower()\n",
        "    own = row[\"medical_specialty\"]\n",
        "    return any(any(tok in kw for tok in toks) for other, toks in spec_tokens.items() if other != own)\n",
        "\n",
