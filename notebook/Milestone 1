        "    \"DISPOSITION\", \"RECOMMENDATION\", \"RECOMMENDATIONS\",\n",
        "]\n",
        "pattern = re.compile(\n",
        "    r\"(?:^|[\\.,\\n])\\s*(\" + \"|\".join(re.escape(h) for h in DECISION_HEADERS) + r\")\\s*:\",\n",
