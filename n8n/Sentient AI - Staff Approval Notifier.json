    {
      "parameters": {
        "jsCode": "// Rows a staff member has approved whose patient has not been told yet.\nconst CLINIC = \"Sentient AI Referral Clinic\";\nconst TZ = \"America/Chicago\";\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const decision = String(r.reviewer_decision ?? \"\").trim().toUpperCase();\n  if (r.route !== \"DRAFT_PENDING_APPROVAL\" || decision !== \"APPROVED\") continue;\n  if (String(r.patient_notified_at ?? \"\").trim()) continue;   // already notified: never send twice\n  if (!String(r.patient_email ?? \"\").includes(\"@\")) continue;\n  const when = DateTime.fromISO(String(r.proposed_start)).setZone(TZ);\n  const whenText = when.isValid ? when.toFormat(\"cccc, LLLL d, yyyy 'at' h:mm a\") : String(r.proposed_start);\n  const name = String(r.patient_first_name || \"\").trim() || \"there\";\n  out.push({ json: {\n    case_id: r.case_id,\n    reviewed_at: r.reviewed_at,\n    patient_email: r.patient_email,\n    email_subject: `Your ${CLINIC} appointment`,\n    email_body:\n`Hello ${name},\n\nA member of our staff has reviewed your referral to ${CLINIC}. Your appointment with our ${r.specialty_suggestion} team is scheduled for ${whenText} (Central Time).\n\nIf you need a different time, reply to this email or call the clinic.\n\nIf your symptoms get worse, or you have chest pain, trouble breathing, sudden weakness, or other severe symptoms, call 911 or go to the nearest emergency department. Do not wait for this appointment.\n\nReference number: ${r.case_id}\n\n${CLINIC}`,\n  }});\n}\nreturn out;"
      },
